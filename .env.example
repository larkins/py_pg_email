# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development

# Database Configuration
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/mail_server

# JWT Secret Key (generate a secure random string for production)
JWT_SECRET=your-super-secret-key-change-this-in-production

# Domain Configuration (Your actual domain and static IP)
# These are used for SMTP EHLO/HELO, reverse DNS, and SPF validation
DOMAIN=example.com
STATIC_IP=0.0.0.0

# Test Email Recipients (for testing email delivery)
# LOCAL_TEST_EMAIL should be an address on your domain
# EXTERNAL_TEST_EMAIL should be an external address like Gmail
LOCAL_TEST_EMAIL=test@example.com
EXTERNAL_TEST_EMAIL=external-test@example.com

# Optional: Test Database (for running tests)
# TEST_DATABASE_URL=postgresql://username:password@localhost:5432/mail_server_test

# CORS allowed origins (comma-separated). Set this to the URL(s) of your web client.
# Include your public domain if accessing via tunnel/reverse proxy, plus localhost for dev.
# If unset, defaults to localhost-only (most restrictive).
# Examples:
#   CORS_ORIGINS=https://mail.example.com
#   CORS_ORIGINS=https://mail.example.com,http://localhost:5005
# CORS_ORIGINS=

# TLS certificate paths for HTTPS on the Flask API (optional but recommended)
# Generate a self-signed cert with:
#   python scripts/generate_tls_cert.py
# Or use your own certificate. Both paths are relative to the project root.
# TLS_CERT=certs/server.crt
# TLS_KEY=certs/server.key

# SMTP STARTTLS (optional — reuses the Flask TLS cert by default)
# Only needed if you want a separate cert for SMTP, or if Flask TLS is not configured.
# SMTP_TLS_CERT_PATH=certs/server.crt
# SMTP_TLS_KEY_PATH=certs/server.key
# Set to 'true' to reject SMTP commands before STARTTLS upgrade (recommended for production)
# SMTP_REQUIRE_STARTTLS=false
