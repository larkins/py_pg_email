# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development

# Database Configuration
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/mail_server

# JWT Secret Key (generate a secure random string for production)
JWT_SECRET=your-super-secret-key-change-this-in-production

# Optional: Test Database (for running tests)
# TEST_DATABASE_URL=postgresql://username:password@localhost:5432/mail_server_test
