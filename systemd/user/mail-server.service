[Unit]
Description=Mail Server (Flask API + SMTP)
After=network.target

[Service]
Type=simple
# WorkingDirectory will be set by install script (default: ~/git/py_pg_email)
WorkingDirectory=PROJECT_ROOT
Environment=FLASK_APP=run.py
Environment=FLASK_ENV=production
Environment=PYTHONPATH=PROJECT_ROOT
Environment=DATABASE_URL=postgresql://localhost/mail_server
Environment=JWT_SECRET=your-production-secret-key-change-this
Environment=PROJECT_ROOT=PROJECT_ROOT

# Use the startup script (path set by install script)
ExecStart=PROJECT_ROOT/venv/bin/python PROJECT_ROOT/start_servers.py --flask-port 5000 --smtp-port 2525

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mail-server

[Install]
WantedBy=default.target
