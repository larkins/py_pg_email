[Unit]
Description=Mail Server (Flask API + SMTP)
After=network.target

[Service]
Type=simple
# WorkingDirectory will be set by install script
WorkingDirectory=__PROJECT_ROOT__
EnvironmentFile=__PROJECT_ROOT__/.env
Environment=FLASK_APP=run.py
Environment=FLASK_ENV=production
Environment=PYTHONPATH=__PROJECT_ROOT__
Environment=PROJECT_ROOT=__PROJECT_ROOT__
Environment=SMTP_RATE_LIMIT_MAX_CONNECTIONS=50

# Use the startup script
ExecStart=__PROJECT_ROOT__/venv/bin/python __PROJECT_ROOT__/start_servers.py --flask-port 5003 --smtp-port 2525

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mail-server

[Install]
WantedBy=default.target
