[Unit]
Description=Mail Server (Flask API + SMTP)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
# User and Group should be set based on your system
# User=your-username
# Group=your-group
WorkingDirectory=__PROJECT_ROOT__
EnvironmentFile=__PROJECT_ROOT__/.env
Environment=FLASK_APP=run.py
Environment=FLASK_ENV=production
Environment=PYTHONPATH=__PROJECT_ROOT__
Environment=PATH=__PROJECT_ROOT__/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PROJECT_ROOT=__PROJECT_ROOT__

# Use the startup script
ExecStart=__PROJECT_ROOT__/start_mail_server.sh

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mail-server

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=__PROJECT_ROOT__/uploads __PROJECT_ROOT__/logs

[Install]
WantedBy=multi-user.target
