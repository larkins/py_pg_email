[Unit]
Description=Mail Server (Flask API + SMTP)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
# User and Group should be set based on your system
# User=your-username
# Group=your-group
WorkingDirectory=PROJECT_ROOT
Environment=FLASK_APP=run.py
Environment=FLASK_ENV=production
Environment=PYTHONPATH=PROJECT_ROOT
Environment=PATH=PROJECT_ROOT/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=DATABASE_URL=postgresql://localhost/mail_server
Environment=JWT_SECRET=your-production-secret-key-change-this
Environment=PROJECT_ROOT=PROJECT_ROOT

# Use the startup script
ExecStart=PROJECT_ROOT/start_mail_server.sh

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mail-server

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=PROJECT_ROOT/uploads PROJECT_ROOT/logs

[Install]
WantedBy=multi-user.target
