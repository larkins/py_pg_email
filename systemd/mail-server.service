[Unit]
Description=Mail Server (Flask API + SMTP)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=mal
Group=mal
WorkingDirectory=/opt/py_pg_accounts/git/py_pg_email
Environment=FLASK_APP=run.py
Environment=FLASK_ENV=production
Environment=PYTHONPATH=/opt/py_pg_accounts/git/py_pg_email
Environment=PATH=/opt/py_pg_accounts/git/py_pg_email/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=DATABASE_URL=postgresql://localhost/mail_server
Environment=JWT_SECRET=your-production-secret-key-change-this

# Use the startup script
ExecStart=/opt/py_pg_accounts/git/py_pg_email/start_mail_server.sh

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mail-server

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/opt/py_pg_accounts/git/py_pg_email/uploads /opt/py_pg_accounts/git/py_pg_email/logs

[Install]
WantedBy=multi-user.target
