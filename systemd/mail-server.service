[Unit]
Description=Mail Server (Flask API + SMTP)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
# User and Group should be set based on your system
# User=your-username
# Group=your-group
WorkingDirectory=/home/mal/git/py_pg_email
Environment=FLASK_APP=run.py
Environment=FLASK_ENV=production
Environment=PYTHONPATH=/home/mal/git/py_pg_email
Environment=PATH=/home/mal/git/py_pg_email/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=DATABASE_URL=postgresql://postgres:1234@localhost:5432/mail_server
Environment=JWT_SECRET=kflss#vQ@oXp!b
Environment=PROJECT_ROOT=/home/mal/git/py_pg_email

# Use the startup script
ExecStart=/home/mal/git/py_pg_email/start_mail_server.sh

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mail-server

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/mal/git/py_pg_email/uploads /home/mal/git/py_pg_email/logs

[Install]
WantedBy=multi-user.target
