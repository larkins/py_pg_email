# Local Email Skill — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================================
# MAIL SERVER
# ============================================================
# Base URL of the Python/PostgreSQL mail server
# The mail server must be running and reachable at this URL
# Use https:// if TLS is enabled (recommended for production)
EMAIL_SERVER=https://192.168.4.41:5003

# Path to the mail server's TLS certificate (optional)
# The script auto-discovers from standard locations, but you can set it explicitly:
# EMAIL_SERVER_CERT=/usr/local/share/ca-certificates/py_pg_email.crt

# Email account for sending and inbox access
EMAIL_ADDRESS=your@yourdomain.com

# Account password
EMAIL_PASSWORD=your_password

# Default recipient for send command (optional — can override with --to)
EMAIL_TO=recipient@example.com
